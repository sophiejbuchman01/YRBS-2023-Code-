# L. Check 5: screening for possibly inaccurate responses ----------------------
# Students are flagged if they chose "4 or more times per day" on at least
# `screen_threshold` of the seven food-frequency items (see Section 1). The main
# estimates are then repeated without flagged students. A second threshold is
# shown so readers can see how sensitive the results are to the cut-off.
 
screen_threshold <- 3
alt_threshold    <- 2
 
flag_tab <- supp %>%
  filter(!is.na(group)) %>%
  group_by(Group = group) %>%
  summarise(Students = n(),
            `Flagged (3+ items)` = sum(extreme_food >= screen_threshold),
            `% flagged (3+)` = round(100 * mean(extreme_food >= screen_threshold), 1),
            `Flagged (2+ items)` = sum(extreme_food >= alt_threshold),
            `% flagged (2+)` = round(100 * mean(extreme_food >= alt_threshold), 1),
            .groups = "drop")
 
flag_tab %>% save_table("S12a_check5_flagged_students")
 
screened <- function(threshold) {
  d <- subset(des_sa, extreme_food < threshold)
  map_dfr(bin_vars, function(v) {
    pr <- prev_by(d, "group", v)
    or <- ratio_by(d, "group", v, "group") %>% rename(group = term)
    left_join(pr, or %>% select(outcome, group, OR = ratio, or_lo = lo, or_hi = hi, p),
              by = c("outcome", "group"))
  }) %>% mutate(threshold = threshold)
}
 
check5 <- bind_rows(screened(screen_threshold), screened(alt_threshold))
 
check5 %>%
  label_outcome() %>%
  transmute(`Flag threshold` = paste0(threshold, "+ items"), Outcome = outcome, Group = group,
            `Percent [95% CI]` = fmt_ci(pct, lo, hi),
            `Odds ratio [95% CI]` = if_else(is.na(OR), "Reference",
                                            fmt_ci(OR, or_lo, or_hi, digits = 2)),
            `p-value` = if_else(is.na(p), "", fmt_p(p)),
            `Students who answered` = n_valid) %>%
  save_table("S12b_check5_screened_results")
 
 
# M. Who answered the closeness question? --------------------------------------
# Students in schools that also ran a state or local YRBS often received that
# questionnaire, which may not include the closeness question (Brener et al., 2024).
# This compares students with and without a closeness response.
 
close_chars <- c(group = "Group", grade = "Grade", race4 = "Race and ethnicity",
                 sexid3 = "Sexual identity")
 
close_who <- map_dfr(names(close_chars), function(var) {
  t <- svychisq(as.formula(paste0("~answered_close + ", var)), des_sa)
  r <- svyby(~answered_close, as.formula(paste0("~", var)), des_sa, svymean, na.rm = TRUE)
  tibble(Characteristic = close_chars[[var]],
         Category = as.character(r[[var]]),
         `% with a closeness response (weighted)` = round(100 * r$answered_close, 1),
         `Rao-Scott p` = c(fmt_p(t$p.value), rep("", nrow(r) - 1)))
})
 
close_who %>% save_table("S13a_closeness_response_by_characteristic")
 
# Do students with and without a closeness response differ on the other outcomes?
close_outcomes <- map_dfr(setdiff(bin_vars, "not_close_bin"), function(v) {
  pr <- prev_by(update(des_sa, answered = factor(answered_close, 0:1, c("No", "Yes"))),
                "answered", v)
  or <- ratio_by(update(des_sa, answered = factor(answered_close, 0:1, c("No", "Yes"))),
                 "answered", v, "answered")
  tibble(outcome = v,
         pct_no = pr$pct[pr$group == "No"], pct_yes = pr$pct[pr$group == "Yes"],
         OR = or$ratio, lo = or$lo, hi = or$hi, p = or$p)
})
 
close_outcomes %>%
  label_outcome() %>%
  transmute(Outcome = outcome,
            `% without closeness response` = round(pct_no, 1),
            `% with closeness response` = round(pct_yes, 1),
            `Odds ratio (with vs. without) [95% CI]` = fmt_ci(OR, lo, hi, digits = 2),
            `p-value` = fmt_p(p)) %>%
  save_table("S13b_closeness_response_and_other_outcomes")
 
 
