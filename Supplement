            `Gap, "male" (pp) [95% CI]`   = fmt_ci(gap_male, gap_male_lo, gap_male_hi),
            `Difference in gaps (pp) [95% CI]` = fmt_ci(diff, diff_lo, diff_hi),
            `p (additive)` = fmt_p(p_add), `Holm p (additive)` = fmt_p(p_add_holm),
