# B. Table 1: sample characteristics by group ----------------------------------
# Weighted column percentages (each group sums to 100% within a characteristic),
# plus unweighted counts. Missing values are excluded from the percentages and
# reported separately.
 
demo_vars <- c(grade = "Grade", age = "Age", race7 = "Race and ethnicity",
               sexual_identity = "Sexual identity")
 
demo_one <- function(var) {
  w <- svytable(as.formula(paste0("~", var, " + group")), des_sa)
  pct <- as.data.frame(prop.table(w, margin = 2) * 100, stringsAsFactors = FALSE) %>%
    rename(category = 1, group = 2, pct = Freq)
  n <- supp %>% filter(!is.na(group), !is.na(.data[[var]])) %>%
    count(category = as.character(.data[[var]]), group = as.character(group))
  miss_n <- supp %>% filter(!is.na(group)) %>%
    group_by(group = as.character(group)) %>%
    summarise(category = "Missing (n)", n = sum(is.na(.data[[var]])), .groups = "drop")
  pct %>%
    mutate(category = as.character(category), group = as.character(group)) %>%
    left_join(n, by = c("category", "group")) %>%
    mutate(n = replace_na(n, 0L)) %>%
    bind_rows(miss_n) %>%
    mutate(characteristic = demo_vars[[var]])
}
 
