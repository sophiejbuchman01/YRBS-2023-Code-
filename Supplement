# 2. Helper functions ----------------------------------------------------------
 
# Survey-weighted percentage with 95% CI (logit method), by any grouping variable
prev_by <- function(design, by, v) {
  r <- svyby(as.formula(paste0("~", v)), as.formula(paste0("~", by)), design,
             svyciprop, vartype = "ci", method = "logit", na.rm = TRUE)
  n_valid <- design$variables %>%
    filter(!is.na(.data[[by]]), !is.na(.data[[v]])) %>%
    count(.data[[by]], name = "n_valid")
  tibble(outcome = v, group = as.character(r[[by]]),
         pct = 100 * r[[2]], lo = 100 * r$ci_l, hi = 100 * r$ci_u) %>%
    left_join(n_valid %>% rename(group = 1) %>% mutate(group = as.character(group)),
              by = "group")
}
 
# Odds ratios (or prevalence ratios with family = quasipoisson(link = "log"))
# for every term that starts with `prefix`
ratio_by <- function(design, rhs, v, prefix, family = quasibinomial()) {
  m <- svyglm(as.formula(paste(v, "~", rhs)), design = design, family = family)
  tidy(m, conf.int = TRUE, exponentiate = TRUE) %>%
    filter(str_starts(term, prefix)) %>%
    transmute(outcome = v, term = str_remove(term, paste0("^", prefix)),
              ratio = estimate, lo = conf.low, hi = conf.high, p = p.value,
              n_used = nobs(m))
}
 
# Percentage-point differences between groups, with design-based 95% CIs.
# `levels` gives the group order; each comparison group is compared with `ref`.
pp_diff_by <- function(design, by, v, levels, ref) {
  b <- svyby(as.formula(paste0("~", v)), as.formula(paste0("~", by)), design,
             svymean, na.rm = TRUE, covmat = TRUE)
  stopifnot(identical(as.character(b[[by]]), levels))
  others <- setdiff(levels, ref)
  K <- lapply(others, function(g) as.numeric(levels == g) - as.numeric(levels == ref))
  names(K) <- others
  con <- svycontrast(b, K)
  est <- coef(con); se <- SE(con); df <- degf(design)
  tibble(outcome = v, group = others,
         diff = 100 * est,
         lo = 100 * (est - qt(.975, df) * se),
         hi = 100 * (est + qt(.975, df) * se),
         p = 2 * pt(-abs(est / se), df))
}
 
 
