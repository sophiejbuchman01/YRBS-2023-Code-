# E. Table 4a: does the transgender gap differ by answer to the sex question? --
# Within the main analytic sample, sex_resp and trans_resp reproduce the four
# groups exactly. Two models per outcome:
#   Additive scale (linear probability model): the interaction term is the
#     difference between the transgender gap among students who answered "male"
#     and the gap among students who answered "female", in percentage points.
#   Multiplicative scale (logistic model): the interaction term is the ratio of
#     the two within-sex odds ratios.
# Holm adjusts across the four outcomes on each scale.
 
interact_one <- function(v) {
  f <- as.formula(paste(v, "~ sex_resp * trans_resp"))
  int <- "sex_respMale:trans_respTransgender"
 
  m_lp <- svyglm(f, design = des_sa)                       # linear probability
  df_lp <- degf(des_sa)   # same degrees of freedom as the percentage-point CIs in Section C
  con <- svycontrast(m_lp, list(gap_female = c(trans_respTransgender = 1),
                                gap_male   = setNames(c(1, 1), c("trans_respTransgender", int)),
                                diff       = setNames(1, int)))
  est <- coef(con); se <- SE(con)
 
  m_lr <- svyglm(f, design = des_sa, family = quasibinomial())
  df_lr <- m_lr$df.residual
  lcon <- svycontrast(m_lr, list(or_female = c(trans_respTransgender = 1),
                                 or_male   = setNames(c(1, 1), c("trans_respTransgender", int)),
                                 ratio     = setNames(1, int)))
  lest <- coef(lcon); lse <- SE(lcon)
 
  tq  <- qt(.975, df_lp); tql <- qt(.975, df_lr)
  tibble(outcome = v,
         gap_female = 100 * est[["gap_female"]],
         gap_female_lo = 100 * (est[["gap_female"]] - tq * se[["gap_female"]]),
         gap_female_hi = 100 * (est[["gap_female"]] + tq * se[["gap_female"]]),
         gap_male = 100 * est[["gap_male"]],
         gap_male_lo = 100 * (est[["gap_male"]] - tq * se[["gap_male"]]),
         gap_male_hi = 100 * (est[["gap_male"]] + tq * se[["gap_male"]]),
         diff = 100 * est[["diff"]],
         diff_lo = 100 * (est[["diff"]] - tq * se[["diff"]]),
         diff_hi = 100 * (est[["diff"]] + tq * se[["diff"]]),
         p_add = 2 * pt(-abs(est[["diff"]] / se[["diff"]]), df_lp),
         or_female = exp(lest[["or_female"]]),
         or_male = exp(lest[["or_male"]]),
         ratio_or = exp(lest[["ratio"]]),
         ratio_lo = exp(lest[["ratio"]] - tql * lse[["ratio"]]),
         ratio_hi = exp(lest[["ratio"]] + tql * lse[["ratio"]]),
         p_mult = 2 * pt(-abs(lest[["ratio"]] / lse[["ratio"]]), df_lr))
}
 
interaction <- map_dfr(bin_vars, interact_one) %>%
  mutate(p_add_holm = p.adjust(p_add, method = "holm"),
         p_mult_holm = p.adjust(p_mult, method = "holm"))
 
interaction %>%
